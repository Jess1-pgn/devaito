                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Formation JavaScript Avancé\",\n  \"description\": \"Maîtrisez JavaScript ES6+\",\n  \"categorie\": \"Développement Web\",\n  \"nombre_heures\": 40,\n  \"cout\": 1500.00,\n  \"objectifs\": \"Maîtriser les concepts avancés de JavaScript\",\n  \"programme\": \"Modules ES6, Async/Await, Promises, etc.\",\n  \"type_public\": \"mixte\",\n  \"ville\": \"Paris\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/formations",
              "host": ["{{base_url}}"],
              "path": ["api", "formations"]
            }
          }
        },
        {
          "name": "Get All Formations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/formations",
              "host": ["{{base_url}}"],
              "path": ["api", "formations"]
            }
          }
        },
        {
          "name": "Get Formation by ID",
          "request": {
