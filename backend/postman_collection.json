              "mode": "raw",
              "raw": "{\n  \"titre\": \"Formation JavaScript ES6+\",\n  \"description\": \"Maîtrisez JavaScript moderne\",\n  \"categorie\": \"Développement Web\",\n  \"nombre_heures\": 45,\n  \"cout\": 1600.00,\n  \"objectifs\": \"Maîtriser JavaScript moderne\",\n  \"programme\": \"ES6+, TypeScript, React\",\n  \"type_public\": \"mixte\",\n  \"ville\": \"Paris\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/formations/1",
