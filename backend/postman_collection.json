              "path": ["api", "formations", "1"]
            }
          }
        },
        {
          "name": "Delete Formation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/formations/1",
              "host": ["{{base_url}}"],
              "path": ["api", "formations", "1"]
            }
          }
        }
      ]
    },
